# املأ القيم في مدير أسرار الاستضافة أو ملف .env محلي مستثنى من Git.
MONGODB_URI=
PORT=10000
# عنوان الإيداع العام المعروض للمستخدمين (قيمة افتراضية موضحة في README).
OFFICIAL_DEPOSIT_WALLET=
# إعداد اختياري لبوت FAQ الخاص. لا تحفظ الرمز أو سر webhook في Git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_APP_URL=https://cloud-platform-app.onrender.com
# اضبط هذا فقط عند تشغيل واجهة Streamlit على أصل مختلف عن خادم Node.
API_BASE_URL=http://127.0.0.1:10000
